<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Agente local do leitor biométrico Nitgen/Fingertech Hamster DX.
    Roda no computador onde o leitor está ligado e atende o portal em http://localhost:9001.
    O SDK eNBioBSP (NITGEN.SDK.NBioBSP.dll) é 32 bits na instalação padrão: por isso o PlatformTarget x86.
    Se você instalou o SDK de 64 bits, troque para x64 e aponte o HintPath para a DLL x64.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>BiometriaAgente</AssemblyName>
    <RootNamespace>BiometriaAgente</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="NITGEN.SDK.NBioBSP">
      <HintPath>lib\NITGEN.SDK.NBioBSP.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
