rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleValue == "administrador-analista";
    }

    // DP de verdade, ou analista com o privilégio "dp" dado pelo administrador (campo "privileges" do usuário).
    function isDp() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleValue == "dp" ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleValue == "analista" &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("privileges", []).hasAny(["dp"])));
    }

    function isIntern() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleValue == "estagiario_engenharia";
    }

    // Analista: perfil "curinga". Por padrão é chefe de equipe (como o encarregado) e importa o relatório do RM;
    // o administrador pode dar acesso de DP, de engenheiro e de segurança do trabalho (campo "privileges").
    function isAnalyst() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleValue == "analista";
    }

    // Engenheiro, ou analista com o acesso de engenheiro.
    function isEngineer() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleValue == "engenheiro" ||
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleValue == "analista" &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("privileges", []).hasAny(["engenheiro"])));
    }

    function isPorter() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleValue == "porteiro";
    }

    // Estagiário ou engenheiro: trabalham na equipe do encarregado a quem estão vinculados.
    function isLinker() {
      return isIntern() || isEngineer();
    }

    function isForeman() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleValue in ["encarregado", "seguranca_trabalho", "analista"];
    }

    // Encarregado a quem o estagiário logado está vinculado (vazio se não estiver).
    function internForeman() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("linkedForeman", "");
    }

    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Além do administrador, DP, encarregado, estagiário e engenheiro podem listar SÓ encarregados, estagiários,
      // engenheiros e DP (para montar e exportar equipes).
      allow list: if isAdmin() ||
        ((isDp() || isForeman() || isLinker()) && resource.data.roleValue in ["encarregado", "estagiario_engenharia", "analista", "engenheiro", "dp"]);
      allow create: if request.auth != null && request.auth.uid == userId;
      // A própria conta não pode mudar o próprio perfil nem os próprios privilégios (só o administrador).
      allow update: if request.auth != null && ((request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["roleValue", "privileges"])) || isAdmin() ||
        // O DP só pode vincular estagiário/engenheiro a um encarregado (campo "linkedForeman"), nada além disso.
        (isDp() && resource.data.roleValue in ["estagiario_engenharia", "engenheiro"] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["linkedForeman", "updatedAt"])));
      allow delete: if isAdmin();
    }

    match /matriculaIndex/{matricula} {
      allow get: if true;
      allow list: if false;
      // Uma matrícula = um cadastro. Só dá para criar o índice se ele ainda não existe (regravar por cima é "update").
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      // A própria conta pode apagar o índice que acabou de criar (para desfazer um cadastro que falhou no meio).
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    match /employees/{employeeId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;
      // Importar o relatório do RM (apaga a lista e grava a nova): administrador, qualquer perfil de DP e analista.
      allow create, delete: if isAdmin() || isDp() || isAnalyst();
      // Administrador, DP e analista mudam qualquer coisa (a importação regrava os colaboradores); o estagiário e o
      // engenheiro mudam SÓ o campo "encarregado", e só para/da equipe do encarregado a quem estão vinculados.
      allow update: if isAdmin() || isDp() || isAnalyst() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["encarregado"]) &&
          ((isLinker() && internForeman() != "" &&
              (request.resource.data.encarregado == internForeman() || request.resource.data.encarregado == "") &&
              (resource.data.encarregado == internForeman() || resource.data.get("encarregado", "") == ""))));
    }

    match /allowedRegistrations/{matricula} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Lixeira por usuário: numa atualização, as listas "hiddenFor"/"purgedFor" só podem ganhar ou perder
    // o id de QUEM está logado. Ninguém esconde nem apaga a liberação do histórico de outra pessoa.
    function onlyOwnIdChanged(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).hasOnly([request.auth.uid]) &&
        before.difference(after).hasOnly([request.auth.uid]);
    }

    function signatureMatchesEmployee() {
      let signature = request.resource.data.get("employeeSignature", null);
      return signature == null || signature.get("matricula", "") == request.resource.data.get("registration", "");
    }

    match /releases/{releaseId} {
      allow read: if request.auth != null;
      // A digital gravada na liberação tem de ser do mesmo colaborador da liberação.
      allow create: if request.auth != null && signatureMatchesEmployee();
      allow update: if request.auth != null && onlyOwnIdChanged("hiddenFor") && onlyOwnIdChanged("purgedFor") &&
        signatureMatchesEmployee();
      // Só o DP (e o administrador) apaga uma liberação de verdade. Os outros perfis só a escondem do
      // próprio histórico (campo "hiddenFor"), sem apagar o documento.
      allow delete: if isDp() || isAdmin();
    }

    // Liberação coletiva (lista de presença de uma tarefa do dia). Quem cria só grava em nome próprio;
    // só o DP e o administrador apagam de verdade.
    match /collectiveReleases/{sheetId} {
      allow read: if request.auth != null;
      // O DP e o administrador também criam ao restaurar um backup (folhas de outras pessoas, com as digitais).
      allow create: if isAdmin() || isDp() ||
        (request.auth != null && request.resource.data.createdByUid == request.auth.uid &&
          !request.resource.data.keys().hasAny(["participantSignatures"]));
      // O engenheiro só mexe nos campos da decisão do abono (assinatura dele).
      allow update: if request.auth != null && (isAdmin() || isDp() || resource.data.createdByUid == request.auth.uid ||
        (isEngineer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ["engineer", "engineerRole", "engineerDecisionAt", "bonusStatus", "hours", "stage", "status", "engineerUndoneAt", "engineerUndoneBy",
           "dpSigner", "dpRole", "dpDecisionAt", "refusedBy", "refusedAt", "refusalReasons", "refusalReason"])) ||
        // A portaria marca a saída de cada colaborador (participantExits), um por um, numa folha autorizada pelo DP...
        (isPorter() && resource.data.get("stage", "") == "gate" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["participantExits"])) ||
        // ...e só confirma a saída da folha (assina como portaria) depois que todos os colaboradores saíram.
        (isPorter() && resource.data.get("stage", "") == "gate" && request.resource.data.stage == "exited" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ["stage", "exitConfirmedBy", "exitConfirmedRole", "exitConfirmedAt"]) &&
          resource.data.get("participantExits", {}).size() >= resource.data.get("participants", []).size()) ||
        // Lixeira: qualquer perfil só põe/tira o PRÓPRIO id nas listas "hiddenFor" e "purgedFor".
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenFor", "purgedFor"]) &&
          onlyOwnIdChanged("hiddenFor") && onlyOwnIdChanged("purgedFor"))) &&
        // Digitais dos colaboradores (participantSignatures): só o DP e o administrador gravam, no leitor do DP.
        (isAdmin() || isDp() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["participantSignatures"]));
      allow delete: if isDp() || isAdmin();
    }

    match /monthlyClosures/{closureId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Digitais do Hamster DX (dado pessoal sensível, LGPD art. 11). Quem registra liberação lê uma de cada vez
    // para conferir o dedo do colaborador; só o DP e o administrador listam, cadastram e apagam.
    match /biometrics/{matricula} {
      allow get: if isAdmin() || isDp() || isForeman() || isLinker();
      allow list: if isAdmin() || isDp();
      allow create, update: if (isAdmin() || isDp()) &&
        request.resource.data.matricula == matricula &&
        request.resource.data.template is string &&
        request.resource.data.template.size() < 20000 &&
        request.resource.data.consentAt is string;
      allow delete: if isAdmin() || isDp();
    }

    match /importRuns/{importId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
